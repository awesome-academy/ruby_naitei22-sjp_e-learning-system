<%# Sử dụng search_form_for của Ransack %>
<%= search_form_for @q, url: user_courses_path, method: :get, class: "filter-form" do |f| %>

  <div class="filter-section">
    <%= f.label :title_cont, t(".search_label"), class: "control-label" %>
    <div class="input-group">
      <%= f.search_field :title_cont,
        placeholder: t(".search_placeholder"),
        class: "form-control" %>
      <span class="input-group-btn">
        <button class="btn btn-primary" type="submit">
          <i class="fa fa-search"></i>
        </button>
      </span>
    </div>
  </div>

  <% if current_user %>
    <div class="filter-section">
      <%= f.label :user_courses_enrolment_status_eq, t(".status"), class: "control-label" %>
      <%= f.select :user_courses_enrolment_status_eq,
          options_for_select(enrolment_status_options, params.dig(:q, :user_courses_enrolment_status_eq)),
          { include_blank: t(".status_all") },
          { class: "form-control" } %>
    </div>
    <div class="filter-section">
      <%= f.label :by_learner_count, t(".learner_count"), class: "control-label" %>
      <%= f.select :by_learner_count,
          options_for_select(learner_count_options, params.dig(:q, :by_learner_count)),
          { include_blank: t(".all_counts") },
          { class: "form-control" } %>
    </div>
  <% end %>

  <div class="form-group mt-2">
    <%= f.submit t(".apply"), class: "btn btn-primary btn-block" %>
    <%= link_to t(".reset"), request.path, class: "btn btn-default btn-block" %>
  </div>
<% end %>
