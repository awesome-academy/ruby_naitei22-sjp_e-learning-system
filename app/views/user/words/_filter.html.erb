<h4 class="filter-header">
  <i class="fa fa-filter"></i> <%= t(".filter_header") %>
</h4>

<%= search_form_for @q, url: user_words_path, method: :get, class: "filter-form" do |f| %>

  <div class="filter-section">
    <%= f.label :keyword, t(".search_label"), class: "control-label" %>
    <div class="input-group">
      <%= text_field_tag :keyword,
            params[:keyword],
            placeholder: t(".search_placeholder"),
            class: "form-control" %>
      <span class="input-group-btn">
        <button class="btn btn-primary" type="submit">
          <i class="fa fa-search"></i>
        </button>
      </span>
    </div>
  </div>

  <div class="filter-section">
    <%= f.label :search_field, t(".search_field_label"), class: "control-label" %>
    <%= select_tag :search_field,
          options_for_select(search_field_options, params[:search_field]&.to_sym),
          class: "form-control" %>
  </div>

  <div class="filter-section">
    <%= label_tag :status, t(".status"), class: "control-label" %>
    <%= select_tag :status,
      options_for_select(status_options, params[:status]&.to_sym),
      class: "form-control" %>
  </div>

  <div class="filter-section">
    <%= f.label :word_type_eq, t(".word_type_label"), class: "control-label" %>
    <%= f.select :word_type_eq,
        options_for_select(word_type_options, params.dig(:q, :word_type_eq)),
        {},
        { class: "form-control" } %>
  </div>


  <div class="filter-section">
    <%= f.label :s, t(".sort_label"), class: "control-label" %>
    <%= f.select :s,
        options_for_select(filter_sort_options, params.dig(:q, :s)),
        { include_blank: t(".sort_options.default_sort") },
        { class: "form-control" } %>
  </div>

  <div class="form-group">
    <%= f.submit t(".apply"), class: "btn btn-primary btn-block" %>
    <%= link_to t(".reset"), request.path, class: "btn btn-default btn-block" %>
  </div>
<% end %>
