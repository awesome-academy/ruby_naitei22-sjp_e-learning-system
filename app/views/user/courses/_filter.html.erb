<%= search_form_for @q, url: request.path, method: :get,
      html: {class: "filter-form", id: "filterForm"} do |f| %>

  <!-- Search Filter -->
  <div class="filter-section">
    <%= f.label :title_cont, t(".search_label"), class: "control-label" %>
    <div class="input-group">
      <%= f.search_field :title_cont,
          placeholder: t(".search_placeholder"),
          class: "form-control",
          id: "searchInput" %>
      <span class="input-group-btn">
        <button class="btn btn-primary" type="submit">
          <i class="fa fa-search"></i>
        </button>
      </span>
    </div>
  </div>

  <!-- Status Filter -->
  <% if current_user %>
    <div class="filter-section">
      <%= label_tag :status, t(".status") %>
      <%= select_tag :status,
            options_for_select(enrolment_status_options, params[:status]&.to_sym),
            class: "form-control" %>
    </div>

  <!-- Enrollee Count Filter -->
    <div class="filter-section">
      <%= f.label :with_enrollee_bucket, t(".enrollee_bucket_label"), class: "control-label" %>
      <%= f.select :with_enrollee_bucket,
            options_for_select(enrollee_bucket_options, params.dig(:q, :with_enrollee_bucket)),
            { include_blank: t(".all_enrollees") },
            class: "form-control" %>
    </div>

    <!-- Action Buttons -->
    <div class="form-group mt-2">
      <%= f.submit t(".apply"), class: "btn btn-primary btn-block" %>
      <%= link_to t(".reset"), request.path, class: "btn btn-default btn-block" %>
    </div>
  <% end %>
<% end %>
